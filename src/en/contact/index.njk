---
layout: layouts/base.njk
title: "Contact — ML Accounting & Controlling LLC"
description: "Get in touch with Marina Lang for support in accounting, controlling or finance transformation."
translationKey: contact
---
<section class="section">
  <div class="container prose">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk</h1>
    <p>
      If you need support in accounting, controlling or finance transformation, I look
      forward to hearing from you.
    </p>

    <ul class="contact-links">
      <li>
        <a class="contact-card" href="mailto:{{ site.email }}">
          <span class="contact-card__icon">{% include "icons/mail.njk" %}</span>
          <span class="contact-card__text">
            <span class="contact-card__label">{{ t.footer.email }}</span>
            <span class="contact-card__value">{{ site.email }}</span>
          </span>
        </a>
      </li>
      <li>
        <a class="contact-card" href="{{ site.linkedin }}" rel="noopener noreferrer" target="_blank">
          <span class="contact-card__icon contact-card__icon--linkedin">{% include "icons/linkedin.njk" %}</span>
          <span class="contact-card__text">
            <span class="contact-card__label">{{ t.footer.linkedin }}</span>
            <span class="contact-card__value">LinkedIn profile</span>
          </span>
          <span class="visually-hidden">{{ t.footer.opensNewTab }}</span>
        </a>
      </li>
    </ul>
  </div>
</section>
