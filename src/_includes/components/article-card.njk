{% macro articleCard(post, lang, readMoreLabel) %}
<article class="article-card">
  <p class="eyebrow">{{ post.date | readableDate(lang) }}</p>
  <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  <p>{{ post.data.excerpt }}</p>
  <a class="article-card__link" href="{{ post.url }}">
    {{ readMoreLabel }}
    {% include "icons/arrow-right.njk" %}
  </a>
</article>
{% endmacro %}
