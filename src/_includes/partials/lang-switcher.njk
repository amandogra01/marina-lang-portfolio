{% set alt = collections.byTranslationKey[translationKey] %}
<nav class="lang-switcher" aria-label="{{ t.langSwitcherLabel }}">
  <ul>
    <li>
      <a href="{{ alt.de or '/' }}" hreflang="de" lang="de" {% if lang == 'de' %}aria-current="page"{% endif %}>DE</a>
    </li>
    <li aria-hidden="true">|</li>
    <li>
      <a href="{{ alt.en or '/en/' }}" hreflang="en" lang="en" {% if lang == 'en' %}aria-current="page"{% endif %}>EN</a>
    </li>
  </ul>
</nav>
