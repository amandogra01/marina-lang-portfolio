<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__brand">{{ site.name }}</p>
    <ul class="site-footer__links">
      <li>
        <a href="mailto:{{ site.email }}">
          {% include "icons/mail.njk" %}
          <span>{{ site.email }}</span>
        </a>
      </li>
      <li>
        <a href="{{ site.linkedin }}" rel="noopener noreferrer" target="_blank">
          <span>{{ t.footer.linkedin }}</span>
          {% include "icons/external-link.njk" %}
          <span class="visually-hidden">{{ t.footer.opensNewTab }}</span>
        </a>
      </li>
    </ul>
    <p class="site-footer__copyright">&copy; {% currentYear %} {{ site.name }}. {{ t.footer.rights }}</p>
  </div>
</footer>
